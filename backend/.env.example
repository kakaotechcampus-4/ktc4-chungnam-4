APP_NAME=Aidam API
APP_ENV=local
API_PORT=8000
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-generated-password
POSTGRES_DB=ktc4
# 얼굴 임베딩 AES 키 — base64로 인코딩한 32바이트. 생성:
#   python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
FACE_EMBEDDING_KEY=replace-with-a-generated-base64-key
# 위 키의 식별자. FaceEmbedding.key_ref에 그대로 저장됩니다
FACE_EMBEDDING_KEY_REF=local-dev-1
# 캠퍼스 LLM 게이트웨이 키. 변수 이름은 ANTHROPIC_ 접두어를 유지합니다
# (팀 결정 — 코드·서버 .env를 한꺼번에 바꾸지 않기 위함).
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
# **이 주소가 모델을 고릅니다.** 게이트웨이는 요청의 model 값을 무시하고
# URL의 UUID로 라우팅합니다 — GLM 엔드포인트에 'x'를 보내도 GLM이 답했습니다.
LLM_GATEWAY_BASE_URL=https://mlapi.run/e569657d-db33-4a42-9750-14f3aa9bd24e/v1
# 게이트웨이가 무시하는 값입니다. 로그에서 어느 모델을 쓰는지 알아보려고 적어둡니다.
ANTHROPIC_MODEL=glm-5.3-flash

# 로그인 토큰 서명 키. 생성:
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-generated-secret
# 토큰 유효 시간(시간). 업로드 도중 끊기지 않게 넉넉히 둡니다.
JWT_EXPIRE_HOURS=24
# 외부에 공개하는 도메인. Caddy가 이 이름으로 HTTPS 인증서를 발급받고,
# 배포 스크립트가 공개 경로 확인에 씁니다. 로컬 개발에서는 쓰이지 않습니다.
PUBLIC_HOST=aidam-ktc.duckdns.org
# Compose에서는 redis:6379로 덮어씁니다. localhost는 별도 로컬 Redis용입니다.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# 연습용 결과 보관 시간(초). 업무 문서 보관 정책과 별개입니다.
CELERY_RESULT_EXPIRES=86400
