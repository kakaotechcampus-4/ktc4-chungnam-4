APP_NAME=Aidam API
APP_ENV=local
API_PORT=8000
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-generated-password
POSTGRES_DB=ktc4
# 얼굴 임베딩 AES 키 — base64로 인코딩한 32바이트. 생성:
#   python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
FACE_EMBEDDING_KEY=replace-with-a-generated-base64-key
# 위 키의 식별자. FaceEmbedding.key_ref에 그대로 저장됩니다
FACE_EMBEDDING_KEY_REF=local-dev-1
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
LLM_GATEWAY_BASE_URL=https://mlapi.run/e9a5f41b-fdda-44f2-9545-ed88c458da53/v1
ANTHROPIC_MODEL=anthropic/claude-sonnet-5

# 로그인 토큰 서명 키. 생성:
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-generated-secret
# 토큰 유효 시간(시간). 업로드 도중 끊기지 않게 넉넉히 둡니다.
JWT_EXPIRE_HOURS=24
# 외부에 공개하는 도메인. Caddy가 이 이름으로 HTTPS 인증서를 발급받고,
# 배포 스크립트가 공개 경로 확인에 씁니다. 로컬 개발에서는 쓰이지 않습니다.
PUBLIC_HOST=aidam-ktc.duckdns.org
# Compose에서는 redis:6379로 덮어씁니다. localhost는 별도 로컬 Redis용입니다.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# 연습용 결과 보관 시간(초). 업무 문서 보관 정책과 별개입니다.
CELERY_RESULT_EXPIRES=86400
# 미디어 원본을 두는 S3 버킷 이름. 비워 두면 앱은 뜨고 업로드 URL 발급만 실패합니다.
# AWS 키는 여기 넣지 않습니다 — 서버는 EC2 인스턴스 롤, 로컬은 `aws sso login`(AWS_PROFILE)으로 받습니다.
S3_BUCKET=
S3_REGION=ap-northeast-2
# 업로드 URL 유효기간(초). 자격증명 잔여 수명보다 길면 발급할 때 잘라냅니다.
S3_UPLOAD_URL_EXPIRES_SECONDS=3600
# 업로드 상한. 요청 한 번에 받는 파일 수와 종류별 파일 크기(바이트).
UPLOAD_MAX_FILES_PER_REQUEST=10
UPLOAD_MAX_PHOTO_BYTES=31457280
UPLOAD_MAX_VIDEO_BYTES=314572800
UPLOAD_MAX_VOICE_MEMO_BYTES=104857600
